# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust the values. `.env` is git-ignored;
# this example is versioned so anyone can run the project with their own
# database. No real credential ever belongs in this file.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Active Spring profile. `dev` enables Swagger UI; `prod` disables it.
SPRING_PROFILES_ACTIVE=dev

# ── PostgreSQL ───────────────────────────────────────────────────────────
# DB_NAME / DB_USER / DB_PASSWORD / DB_PORT are read by docker-compose.yml.
# DB_URL / DB_USER / DB_PASSWORD are read by the Spring Boot application.
# Keep them consistent with each other.
DB_NAME=clicktucasa_db
DB_PORT=5432
DB_USER=dev_user
DB_PASSWORD=change_this_password
DB_URL=jdbc:postgresql://localhost:5432/clicktucasa_db

# Hibernate schema strategy: `update` in development, `validate` in production.
JPA_DDL_AUTO=update

# ── CORS ─────────────────────────────────────────────────────────────────
# Origins the browser is allowed to read this API from. Comma separated,
# exact match: scheme included, no trailing slash.
CORS_ALLOWED_ORIGINS=http://localhost:5173
