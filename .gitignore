# ── Build output ─────────────────────────────────────────────────────────
target/
*.class

# ── Secrets: never versioned ─────────────────────────────────────────────
# The negation is deliberate: `.env.*` would otherwise also swallow the
# example file, and that file is the one thing a reviewer needs in order to
# run this project with their own credentials.
.env
.env.*
!.env.example

# ── IDE ──────────────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
.settings/
.classpath
.project

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# Carpeta que crea la app de escritorio de Claude al entregar archivos
Claude outputs/
